{
  "expo": {
    "name": "Organiza",
    "slug": "belegguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "belegguard",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.facillabs.belegguard",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes and photograph receipts",
        "NSPhotoLibraryUsageDescription": "Attach receipt photos from your gallery"
      }
    },
    "android": {
      "package": "com.facillabs.belegguard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EBF7F5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EBF7F5"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcodes and photograph receipts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach receipt photos from your gallery",
          "cameraPermission": "Photograph receipts to store them"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2B5A50"
        }
      ],
      "react-native-google-mobile-ads"
    ],
    "extra": {
      "ads": {
        "bannerUnitId": null
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
