# =============================================================================
# BelegGuard / Recibo Fácil — repository ignore rules
# Local-first Expo app. Nothing below is required to BUILD the app; these are
# caches, build outputs, secrets and agent/tooling artifacts.
# =============================================================================

# --- Dependencies ------------------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# --- Expo / Metro / build outputs --------------------------------------------
.expo/
**/.expo/
.metro-cache/
**/.metro-cache/
.metro-health-check*
dist/
web-build/
/build
expo-env.d.ts
*.tsbuildinfo

# --- Native build outputs ----------------------------------------------------
*.apk
*.aab
*.ipa
**/android/app/build/
**/ios/build/

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & secrets ---------------------------------------------------
.env
.env.*
*.env
!.env.example
credentials.json
*token.json*
*credentials.json*
*.key
.credentials

# --- Signing material & service accounts (NEVER commit) ----------------------
*.jks
*.keystore
*.p8
*.p12
*.pem
*.crt
*.mobileprovision
google-services.json
GoogleService-Info.plist
**/*service-account*.json

# --- Editors & OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Python (only relevant to the unused backend scaffolding) ----------------
__pycache__/
*.pyc
venv/
.venv/

# =============================================================================
# Agent / Emergent / tooling artifacts — NOT part of the Expo app.
# Kept on disk locally for tooling context, but excluded from the productive
# app repository / branch.
# =============================================================================
.emergent/
memory/
test_reports/
test_result.md
design_guidelines.json
